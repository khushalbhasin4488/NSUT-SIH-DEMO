{
  "realm": "legal-metrology",
  "enabled": true,
  "displayName": "Legal Metrology",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      { "name": "CONSUMER", "description": "Public consumer" },
      { "name": "BUSINESS", "description": "Instrument owner" },
      { "name": "LMO", "description": "Legal Metrology Officer" },
      { "name": "GATC", "description": "Government Approved Test Centre" },
      { "name": "STATE_ADMIN", "description": "State administrator" },
      { "name": "CENTRAL_ADMIN", "description": "Central administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "metrology-web",
      "name": "Legal Metrology Web",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3001"],
      "defaultClientScopes": ["roles", "profile", "email", "basic", "web-origins", "acr"],
      "protocolMappers": [
        {
          "name": "state-code",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "state_code",
            "claim.name": "state_code",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "district-code",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "district_code",
            "claim.name": "district_code",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "metrology-api",
      "name": "Legal Metrology API",
      "publicClient": false,
      "protocol": "openid-connect",
      "bearerOnly": true
    }
  ],
  "users": [
    {
      "username": "business",
      "email": "business@example.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Business",
      "credentials": [{ "type": "password", "value": "Demo@12345", "temporary": false }],
      "realmRoles": ["BUSINESS"],
      "attributes": { "state_code": ["DL"], "district_code": ["Central"] }
    },
    {
      "username": "officer",
      "email": "officer@example.gov.in",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Officer",
      "credentials": [{ "type": "password", "value": "Demo@12345", "temporary": false }],
      "realmRoles": ["LMO"],
      "attributes": { "state_code": ["DL"], "district_code": ["Central"] }
    },
    {
      "username": "gatc",
      "email": "gatc@example.gov.in",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "GATC",
      "credentials": [{ "type": "password", "value": "Demo@12345", "temporary": false }],
      "realmRoles": ["GATC"],
      "attributes": { "state_code": ["DL"], "district_code": ["Central"] }
    },
    {
      "username": "stateadmin",
      "email": "stateadmin@example.gov.in",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "State Admin",
      "credentials": [{ "type": "password", "value": "Demo@12345", "temporary": false }],
      "realmRoles": ["STATE_ADMIN"],
      "attributes": { "state_code": ["DL"], "district_code": ["Central"] }
    },
    {
      "username": "admin",
      "email": "admin@example.gov.in",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Central Admin",
      "credentials": [{ "type": "password", "value": "Demo@12345", "temporary": false }],
      "realmRoles": ["CENTRAL_ADMIN"],
      "attributes": { "state_code": ["DL"] }
    }
  ]
}
